# ────────────────────────────────────────────────────────────────────
# ZyncSwap — Environment Variables
# Copy this file to .env and fill in your values.
# All variables are optional — defaults are listed below.
# ────────────────────────────────────────────────────────────────────

# --- Blockchain ---
# Chain ID (31337 = Hardhat local, 1 = Ethereum mainnet, 11155111 = Sepolia)
CHAIN_ID=31337
# EVM RPC endpoint (Hardhat default, Infura/Alchemy for testnet/mainnet)
RPC_URL=http://127.0.0.1:8545
# Deployed ZyncToken contract address (printed by npm run deploy)
ZYNC_TOKEN_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# --- App identity ---
COMPANY_NAME=Zync
APP_NAME=ZYNC
AURELEXA_TAGLINE=Pay for AureLexa usage and premium care with ZYNC.
AURELEXA_PREMIUM_MIN_WEI=

# --- Server ---
PORT=3000

# --- API Auth ---
# If set, POST/DELETE /api/v1/orders require x-api-key header.
# Leave empty to disable auth (local dev).
API_KEY=

# --- WalletConnect ---
# Required for WalletConnect QR code modal.
# Get a project ID at https://cloud.walletconnect.com (free tier)
# Default demo ID (replace for production):
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=d5bf2f7795f9ea323346f78d38c921b4

# --- Engine tuning (optional) ---
# Reconnection base delay (ms) for the Binance WebSocket feed
WS_RECONNECT_BASE_MS=5000
# Path to persist matching engine state
MATCHING_STATE_PATH=data/matching_state.json
# Market broadcast interval (ms) for the WebSocket feed
BROADCAST_INTERVAL_MS=2000
# Max candle limit for GET /api/v1/markets/:id/candles
MAX_CANDLE_LIMIT=500

# --- Uniswap V2 swap routing (optional) ---
# Deployed router and WETH addresses for swap quotes
SWAP_ROUTER_ADDRESS=
WETH_ADDRESS=
SWAP_DEADLINE_SECS=600
